{
  "name": "UberBond CoS private Codespace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "codespaces",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },
  "forwardPorts": [
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "CoS private desktop (noVNC)",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "postCreateCommand": "bash scripts/cos-codespace/bootstrap.sh",
  "runArgs": [
    "--init",
    "--shm-size=1g"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
