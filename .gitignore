# No trailing slash: with one, this pattern matches only a directory, and a
# SYMLINK named node_modules slips past it. That happened -- a self-referential
# node_modules symlink was committed, and any checkout of it shadows the real
# dependency tree, so npm and every test fail with module-not-found.
node_modules
data/db.json
data/screenshots/*
!data/screenshots/.gitkeep
.env
.DS_Store

# Founder launch facts hold a postal address; they live outside the repo (see scripts/outreach-launch-facts.mjs).
launch-facts*.json

# Local private PHOENIX Git bundles and recovery drills must never enter the public repository.
.phoenix-backups-private/

# Quant lab raw archives are re-derivable from public URLs + publisher SHA-256; only manifests are committed.
data/quant-vault/

# Locally regenerated private founder intellectual archives and public-book cache
.cache/ubermind-books/
.local/ubermind-archives/
scripts/__pycache__/
