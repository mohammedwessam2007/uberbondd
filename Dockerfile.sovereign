FROM mcr.microsoft.com/playwright:v1.61.1-noble

WORKDIR /app

# Sovereign builds are intentionally boring: dependencies must already exist in
# the authoring checkout from a deliberate seed. No package registry, Git host,
# or other network service is consulted while the release image is created.
COPY . .

ENV NODE_ENV=production
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

RUN test -d node_modules \
 && node --version \
 && node -e "const p=require('./package.json'); if(!p.private) process.exit(2)" \
 && chmod +x ops/sovereign/uberbondctl ops/sovereign/install-host.sh 2>/dev/null || true

EXPOSE 8080
CMD ["node", "portable-server.mjs"]
