FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
RUN npm install --ignore-scripts --no-audit --no-fund --save-exact pg@8.22.0
COPY src/uberwinnr-adapter.mjs src/provider-http-adapters.mjs src/provider-receipt-redaction.mjs ./src/
COPY src/uberwarm2-operational-journal.mjs ./src/
COPY src/uberwarm2-winnr-token-permissions.mjs ./src/
COPY src/uberwarm-reputation-lab.mjs src/uberwarm2-sovereign-live-observer.mjs ./src/
COPY src/uberwarm2-provider-dns-spotcheck.mjs ./src/
COPY src/uberwarm2-provider-event-log-observer.mjs ./src/
COPY src/uberwarm2-free-organic-fleet.mjs ./src/
COPY src/uberwarm2-receiver-binding.mjs src/uberimap.mjs src/crypto.mjs src/csv.mjs src/uberwarm2-seed-template.mjs ./src/
COPY scripts/uberwarm2-live-read-doctor.mjs scripts/uberwarm2-railway-read-monitor.mjs ./scripts/
COPY scripts/uberwarm2-migrate-operational-journal.mjs ./scripts/
COPY scripts/uberwarm2-migrate-receiver-binding.mjs scripts/uberwarm2-enroll-winnr-receiver.mjs ./scripts/
