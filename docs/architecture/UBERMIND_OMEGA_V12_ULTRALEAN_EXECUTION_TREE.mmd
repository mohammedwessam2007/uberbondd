  JEVQ -- "Separate explicit authority" --> JEV["EXISTING JEV 1.13 W11–W22<br/>Scoped tensor/cache/single-flight/budget/source gates"]
  JEV --> LOCAL
  LOCAL --> NEED{"07 INTELLIGENCE NECESSARY FOR RESIDUAL?"}
  NEED -- "Native tools can answer" --> NATIVE
  NEED -- "Routine clear acceptance" --> SOLO["L1 CURRENT SELECTED MODEL SOLO<br/>Sonnet when available, smallest useful effort<br/>No paid subscription extras"]
  NEED -- "Large read-only lookup with context savings" --> SCOUT["L2 BOUNDED HAIKU SCOUT<br/>Read/Grep/Glob • max 6 turns<br/>source lines only • no policy authority"]
  NEED -- "Novel/consequential/quality risk" --> CROWN["L3 OPUS FRONTIER CROWN WHEN AVAILABLE<br/>Full strength for irreducible complexity<br/>Clean architecture → one brief proof contract"]
  SCOUT --> CONTRACTS["08 SCRIPT-FIRST PROOF CONTRACT<br/>DAG, named files, tests, owner auth, source SHA"]
  CROWN --> CONTRACTS
  CONTRACTS --> TEAM{"09 WHOLE-TEAM COST VS VERIFIED BENEFIT?"}
  TEAM -- "NO: default" --> SOLO
  TEAM -- "YES, independent work" --> BUS["L4 OPTIONAL OWNED WORKTREE TEAM<br/>Sonnet builder + independent falsifier<br/>Haiku scout only with net benefit"]
  BUS --> DELTA["COMPACT PEER RECEIPTS<br/>Only changed lines, failing tests, unclear claims"]
  SOLO --> DELTA
  DELTA --> HARD{"10 FRONTIER-LEVEL UNCERTAINTY LEFT?"}
  HARD -- "YES" --> REVIEW["OPUS REVIEW JUST THE HARD DELTA<br/>No giant replay or permanent swarm"]
  HARD -- "NO" --> COURT
  REVIEW --> COURT["11 REALITY COURT<br/>Exact acceptance • adversarial tests<br/>Provenance • security • external effects"]
  NATIVE --> COURT
  COURT --> ACCEPT{"QUALITY MATCHED AND AUTHORIZED?"}
