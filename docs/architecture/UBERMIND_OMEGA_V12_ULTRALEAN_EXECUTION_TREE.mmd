  ACCEPT -- "YES" --> OUTPUT["12 COMPLETED ARTIFACT / GOVERNED GIT RECEIPT"]
  OUTPUT --> PHOENIX["13 PHOENIX CRYSTALLIZATION<br/>Proof #57, Error #58, Prediction #59<br/>Civilization Git #61, self-falsification #653<br/>Cache valid exact circuits for next task"]
  PHOENIX -. "valid next-task proof" .-> EXACT
  OUTPUT --> METER["14 REAL FIVE-HOUR METER IF ACCESSIBLE<br/>All agent usage including retries and tests<br/>Else record UNKNOWN, never invent reduction"]
  METER --> POL{"SAME QUALITY, LOWER VERIFIED USAGE?"}
  POL -- "YES" --> PROMOTE["Promote task-class-specific routing"];
  POL -- "NO / UNKNOWN" --> KEEP["Keep proof boundaries; tune only after evidence"]
  PROMOTE -. "self-improve only with receipts" .-> NEED
