 CONTEXT --> FUEL{"Pro session and weekly usage available? Check /status"}
 FUEL -- "No" --> STOP["No paid fallback: save checkpoint and wait for legitimate reset"]
 FUEL -- "Yes" --> EX{"Can E0–E4 exact code, cached accepted output, solver or tests finish?"}
 EX -- "Yes" --> DETER["Execute verified deterministic work: $0 fresh Claude or Jev inference"]
 EX -- "No" --> ROUTE{"Typed bounded decision needs actual Jev?"}
 ROUTE -- "Yes" --> AUTHJ{"Existing independent Jev API authorization, balance, scope and budget?"}
 AUTHJ -- "Yes" --> JEV["Jev 1.13: NOUL / CHOICE / SCORE; exact tensor coalescing; price $0.042/M input"]
 AUTHJ -- "No" --> STATIC["Rules-based routing; no claim that Jev was invoked"]
 JEV --> JEVSTATE["W11–W22 scoped reuse, single-flight, global fresh spend cap, source truth, unknown dispatch hold"]
 JEVSTATE --> QUALITY{"Bounded / independently valid answer sufficient?"}
 QUALITY -- "Yes" --> DETER
 QUALITY -- "No / unknown" --> TIER
 ROUTE -- "No" --> TIER
 STATIC --> TIER
 TIER{"How much actual cognition is justified?"}
 TIER -- "Routine / specified" --> SON["Sonnet 5.5: medium/high; one primary builder in Claude Pro"]
 TIER -- "Scout needed" --> HAI["Haiku 5.5: bounded read-only mapping and retrieval on Pro"]
 TIER -- "Novel / irreversible architecture" --> OP["Opus 5.5: high/xhigh one clean architecture baseline on Pro if available"]
 OP --> PLAN["Source-bound spec / contracts / file ownership / acceptance tests"]
 HAI --> PLAN
 PLAN --> MODE{"Independent parallel work reduces risk enough to justify quota?"}
 MODE -- "No" --> SON
 MODE -- "Yes" --> TEAM["Optional Agent Team: 1 lead + max 2 focused teammates; stop when idle"]
 TEAM --> BUILD["Builder Sonnet: isolated worktree / bounded owned paths"]
 TEAM --> ADV["Tester Sonnet: independent hostile tests, never approve own code"]
 SON --> BUILD
 BUILD --> P2P["Peer messages = typed receipts, not authority; no competing writes"]
 ADV --> P2P
 P2P --> REVIEW["Crown review: Opus only unresolved semantic or high-stakes deltas"]
 REVIEW --> OUT
 DETER --> OUT["Reality Court: tests, source, diff, conflicts, regression, secrets"]
 OUT --> GATE{"Accepted output + effect authority?"}
 GATE -- "No" --> HOLD["Quarantine / repair / block; report unknowns"]
 GATE -- "Yes, internal" --> FINAL["Deliver accepted artifact, exact commit, tests, citations"]
 GATE -- "External effect requires approval" --> OWNER["Existing specific authorization + consequence budget + CI"]
 OWNER -- "Authorized" --> DEPLOY["Governed PR, merge, deploy, reconcile actual effects"]
 OWNER -- "Not authorized" --> HOLD
 DEPLOY --> FINAL
 FINAL --> LEARN["Proof / Error / Prediction Accounting / Compression / PHOENIX"]
 LEARN -. "Safe certified code and scoped reuse only" .-> EX
 LEARN -. "Task-class model improvements" .-> TIER
 LEARN -. "New idea lineage" .-> GENESIS
