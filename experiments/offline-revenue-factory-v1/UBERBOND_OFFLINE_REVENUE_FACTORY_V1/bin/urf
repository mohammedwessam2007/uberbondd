#!/usr/bin/env bash
# Command runner for the UberBond Offline Revenue Factory.
# Resolves its own location so it works from any current directory.
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
ROOT="$(dirname -- "$SCRIPT_DIR")"
exec python3 "$ROOT/src/urf/cli.py" "$@"
