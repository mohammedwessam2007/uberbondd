#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

CONFIG="${UBERBOND_AUTHOR_CONFIG:-/etc/uberbond/authoring.env}"
[[ -f "$CONFIG" && ! -L "$CONFIG" ]] || { echo "REFUSED: regular authoring config required: $CONFIG" >&2; exit 2; }
# shellcheck disable=SC1090
source "$CONFIG"
SOURCE_ROOT="${UBERBOND_SOURCE_ROOT:?UBERBOND_SOURCE_ROOT required}"
CONTROL_DIR="${UBERBOND_CONTROL_DIR:-/var/lib/uberbond-control}"
AUTONOMY_DIR="$CONTROL_DIR/autonomy"
PAUSE_FILE="$AUTONOMY_DIR/PAUSED"
STATUS_FILE="$AUTONOMY_DIR/status.json"
TASK_FILE="$AUTONOMY_DIR/next-task.json"
RESULT_FILE="$AUTONOMY_DIR/worker-result.json"
VERIFIED_FILE="$AUTONOMY_DIR/verified-change.json"
NODE="${UBERBOND_NODE_EXECUTABLE:-/usr/bin/node}"

mkdir -p "$AUTONOMY_DIR"
chmod 700 "$AUTONOMY_DIR" 2>/dev/null || true
[[ -d "$SOURCE_ROOT" && ! -L "$SOURCE_ROOT" ]] || { echo "REFUSED: real source directory required" >&2; exit 2; }
[[ -x "$NODE" && ! -L "$NODE" ]] || { echo "REFUSED: trusted Node executable required" >&2; exit 2; }

run_from_source(){ (cd "$SOURCE_ROOT" && "$@"); }
json_status(){
  if [[ -f "$STATUS_FILE" && ! -L "$STATUS_FILE" ]]; then cat "$STATUS_FILE"; else printf '%s\n' '{"ok":true,"status":"NO_AUTONOMY_PULSE_RECORDED"}'; fi
}

wake(){
  run_from_source env \
    UBERBOND_CONTROL_DIR="$CONTROL_DIR" \
    UBERBOND_LOCAL_WORKER_EXECUTABLE="${UBERBOND_LOCAL_WORKER_EXECUTABLE:-}" \
    UBERBOND_LOCAL_WORKER_TIMEOUT_MS="${UBERBOND_LOCAL_WORKER_TIMEOUT_MS:-2700000}" \
    "$NODE" scripts/sovereign-autonomy-pulse.mjs
  local status
  status="$($NODE -e "const fs=require('fs');const p=process.argv[1];const v=JSON.parse(fs.readFileSync(p,'utf8'));process.stdout.write(String(v.status||''));" "$STATUS_FILE")"
  if [[ "$status" == "CANDIDATE_READY_FOR_INDEPENDENT_SANDBOX_VERIFICATION" ]]; then
    verify
  fi
}

verify(){
  [[ -f "$TASK_FILE" && ! -L "$TASK_FILE" && -f "$RESULT_FILE" && ! -L "$RESULT_FILE" ]] || { echo "REFUSED: task and worker result required" >&2; exit 2; }
  run_from_source env UBERBOND_CONTROL_DIR="$CONTROL_DIR" UBERBOND_REPOSITORY="${UBERBOND_REPOSITORY:-local/uberbond}" "$NODE" scripts/sovereign-autonomy-verify.mjs
}

pause(){
  local tmp="${PAUSE_FILE}.tmp.$$"
  printf 'paused_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$PAUSE_FILE"
  printf '%s\n' 'FOUNDER_PAUSED'
}

resume(){
  rm -f "$PAUSE_FILE"
  printf '%s\n' 'FOUNDER_RESUMED'
  wake
}

help(){
  cat <<'EOF'
UberBond Sovereign Authoring Command Center

  uberbond-authorctl status   exact local autonomy receipt
  uberbond-authorctl wake     regenerate truth and run one bounded local pulse
  uberbond-authorctl pause    durably stop new authoring pulses
  uberbond-authorctl resume   remove pause and immediately wake
  uberbond-authorctl verify   independently verify an existing worker candidate
  uberbond-authorctl help     show this help

This control surface does not merge, sign, deploy, send, spend, mutate DNS,
change credentials, contact customers, or grant business-effect authority.
EOF
}

case "${1:-}" in
  status) json_status ;;
  wake) wake ;;
  pause) pause ;;
  resume) resume ;;
  verify) verify ;;
  help|--help|-h) help ;;
  *) help >&2; exit 2 ;;
esac
