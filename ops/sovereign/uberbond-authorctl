#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

CONFIG="${UBERBOND_AUTHOR_CONFIG:-/etc/uberbond/authoring.env}"
[[ -f "$CONFIG" && ! -L "$CONFIG" ]] || { echo "REFUSED: regular authoring config required: $CONFIG" >&2; exit 2; }
# shellcheck disable=SC1090
source "$CONFIG"
SOURCE_ROOT="${UBERBOND_SOURCE_ROOT:?UBERBOND_SOURCE_ROOT required}"
CONTROL_DIR="${UBERBOND_CONTROL_DIR:-/var/lib/uberbond-control}"
AUTONOMY_DIR="$CONTROL_DIR/autonomy"
CONTEXT_DIR="${UBERBOND_CONTEXT_DIR:-$CONTROL_DIR/context}"
CONTEXT_JOURNAL="${UBERBOND_CONTEXT_JOURNAL_PATH:-$CONTEXT_DIR/events.jsonl}"
BRAINSTATE_FILE="${UBERBOND_BRAINSTATE_PATH:-$CONTEXT_DIR/brainstate.json}"
CONTEXT_MOUNT_FILE="${UBERBOND_CONTEXT_MOUNT_PATH:-$CONTEXT_DIR/mount.json}"
CONTEXT_SYNC_FILE="${UBERBOND_CONTEXT_SYNC_PATH:-$CONTEXT_DIR/sync.json}"
PAUSE_FILE="$AUTONOMY_DIR/PAUSED"
STATUS_FILE="$AUTONOMY_DIR/status.json"
TASK_FILE="$AUTONOMY_DIR/next-task.json"
WAKE_LOCK="$AUTONOMY_DIR/authoring-pulse.lock"
WORKER_RESULT="${UBERBOND_WORKER_RESULT_PATH:-/var/lib/uberbond-worker/outbox/result.json}"
VERIFIED_FILE="$AUTONOMY_DIR/verified-change.json"
NODE_CONFIGURED="${UBERBOND_NODE_EXECUTABLE:-/usr/bin/node}"
NODE="$(realpath "$NODE_CONFIGURED" 2>/dev/null || true)"

mkdir -p "$AUTONOMY_DIR" "$CONTEXT_DIR"
chmod 700 "$AUTONOMY_DIR" "$CONTEXT_DIR" 2>/dev/null || true
[[ -d "$SOURCE_ROOT" && ! -L "$SOURCE_ROOT" ]] || { echo "REFUSED: real source directory required" >&2; exit 2; }
[[ -n "$NODE" && -x "$NODE" && ! -L "$NODE" ]] || { echo "REFUSED: trusted real Node executable required" >&2; exit 2; }
command -v flock >/dev/null 2>&1 || { echo "REFUSED: flock required for single-writer authoring" >&2; exit 2; }
run_from_source(){ (cd "$SOURCE_ROOT" && "$@"); }
json_status(){ if [[ -f "$STATUS_FILE" && ! -L "$STATUS_FILE" ]]; then cat "$STATUS_FILE"; else printf '%s\n' '{"ok":true,"status":"NO_AUTONOMY_PULSE_RECORDED"}'; fi; }

context_sync(){
  local tmp="${CONTEXT_SYNC_FILE}.tmp.$$"
  rm -f "$tmp"
  if ! run_from_source env \
      UBERBOND_CONTROL_DIR="$CONTROL_DIR" \
      UBERBOND_SOURCE_ROOT="$SOURCE_ROOT" \
      UBERBOND_CONTEXT_JOURNAL_PATH="$CONTEXT_JOURNAL" \
      UBERBOND_BRAINSTATE_PATH="$BRAINSTATE_FILE" \
      UBERBOND_CONTEXT_MOUNT_PATH="$CONTEXT_MOUNT_FILE" \
      "$NODE" scripts/sovereign-context-sync.mjs > "$tmp"; then
    [[ ! -f "$tmp" ]] || cat "$tmp" >&2
    rm -f "$tmp"
    return 2
  fi
  chmod 600 "$tmp"
  mv -f "$tmp" "$CONTEXT_SYNC_FILE"
}

context_show(){
  run_from_source env \
    UBERBOND_CONTROL_DIR="$CONTROL_DIR" \
    UBERBOND_SOURCE_ROOT="$SOURCE_ROOT" \
    UBERBOND_CONTEXT_JOURNAL_PATH="$CONTEXT_JOURNAL" \
    UBERBOND_BRAINSTATE_PATH="$BRAINSTATE_FILE" \
    UBERBOND_CONTEXT_MOUNT_PATH="$CONTEXT_MOUNT_FILE" \
    "$NODE" scripts/sovereign-context-mount.mjs
}

checkpoint(){
  run_from_source env \
    UBERBOND_CONTROL_DIR="$CONTROL_DIR" \
    UBERBOND_SOURCE_ROOT="$SOURCE_ROOT" \
    UBERBOND_CONTEXT_JOURNAL_PATH="$CONTEXT_JOURNAL" \
    UBERBOND_BRAINSTATE_PATH="$BRAINSTATE_FILE" \
    "$NODE" scripts/sovereign-context-checkpoint.mjs
}

wake(){
  exec 9>"$WAKE_LOCK"
  if ! flock -n 9; then
    printf '%s\n' 'AUTHORING_PULSE_ALREADY_ACTIVE'
    return 0
  fi
  # Every resident/manual/event wake first mounts exact-current Brainstate and
  # appends a durable checkpoint only when that Brainstate changed. A context
  # integrity failure blocks authoring instead of letting a stale parallel brain
  # continue from conversational memory.
  context_sync
  run_from_source env \
    UBERBOND_CONTROL_DIR="$CONTROL_DIR" \
    UBERBOND_ISOLATED_WORKER_ENABLED="${UBERBOND_ISOLATED_WORKER_ENABLED:-false}" \
    UBERBOND_WORKER_INBOX_ROOT="${UBERBOND_WORKER_INBOX_ROOT:-/var/lib/uberbond-worker/inbox}" \
    UBERBOND_WORKER_TASK_PATH="${UBERBOND_WORKER_TASK_PATH:-/var/lib/uberbond-worker/inbox/task.json}" \
    "$NODE" scripts/sovereign-autonomy-pulse.mjs
}

verify(){
  [[ -f "$TASK_FILE" && ! -L "$TASK_FILE" && -f "$WORKER_RESULT" && ! -L "$WORKER_RESULT" ]] || { echo "REFUSED: authoring task and isolated worker result required" >&2; exit 2; }
  run_from_source env \
    UBERBOND_CONTROL_DIR="$CONTROL_DIR" \
    UBERBOND_WORKER_OUTBOX_ROOT="${UBERBOND_WORKER_OUTBOX_ROOT:-/var/lib/uberbond-worker/outbox}" \
    UBERBOND_WORKER_RESULT_PATH="$WORKER_RESULT" \
    UBERBOND_REPOSITORY="${UBERBOND_REPOSITORY:-local/uberbond}" \
    "$NODE" scripts/sovereign-autonomy-verify.mjs
}

doctor(){
  run_from_source env \
    UBERBOND_CONTROL_DIR="$CONTROL_DIR" \
    UBERBOND_SOURCE_ROOT="$SOURCE_ROOT" \
    "$NODE" scripts/sovereign-bootstrap-doctor.mjs
}

pause(){ local tmp="${PAUSE_FILE}.tmp.$$"; printf 'paused_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$tmp"; chmod 600 "$tmp"; mv -f "$tmp" "$PAUSE_FILE"; printf '%s\n' 'FOUNDER_PAUSED'; }
resume(){ rm -f "$PAUSE_FILE"; printf '%s\n' 'FOUNDER_RESUMED'; wake; }
help(){ cat <<'EOF'
UberBond Sovereign Authoring Command Center

  uberbond-authorctl status      exact local autonomy receipt
  uberbond-authorctl wake        mount current Brainstate, then emit one bounded task
  uberbond-authorctl context     verify and print the current Context Mount
  uberbond-authorctl checkpoint  append an explicit verified Brainstate checkpoint
  uberbond-authorctl pause       durably stop new authoring pulses
  uberbond-authorctl resume      remove pause and immediately wake
  uberbond-authorctl verify      independently verify isolated worker output
  uberbond-authorctl doctor      inspect sovereign self-completion activation truth
  uberbond-authorctl help        show this help

All wake paths share a local single-writer lock. The resident continuum, founder
intent path, post-promotion path, manual wake and resume therefore cannot run two
authoring brains concurrently. Before any authoring pulse, Context Sync verifies
and mounts exact-current Brainstate and journals a checkpoint only when the
Brainstate changed. Integrity failure blocks the pulse rather than silently
falling back to conversational memory.

The model worker is a separate OS identity with read-only source and no access to
authoring receipts. This control surface does not merge, sign, deploy, send,
spend, mutate DNS/credentials, contact customers, or grant business authority.
EOF
}
case "${1:-}" in
  status) json_status ;;
  wake) wake ;;
  context) context_show ;;
  checkpoint) checkpoint ;;
  pause) pause ;;
  resume) resume ;;
  verify) verify ;;
  doctor) doctor ;;
  help|--help|-h) help ;;
  *) help >&2; exit 2 ;;
esac
