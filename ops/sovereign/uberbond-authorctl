#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

CONFIG="${UBERBOND_AUTHOR_CONFIG:-/etc/uberbond/authoring.env}"
[[ -f "$CONFIG" && ! -L "$CONFIG" ]] || { echo "REFUSED: regular authoring config required: $CONFIG" >&2; exit 2; }
# shellcheck disable=SC1090
source "$CONFIG"
SOURCE_ROOT="${UBERBOND_SOURCE_ROOT:?UBERBOND_SOURCE_ROOT required}"
CONTROL_DIR="${UBERBOND_CONTROL_DIR:-/var/lib/uberbond-control}"
AUTONOMY_DIR="$CONTROL_DIR/autonomy"
PAUSE_FILE="$AUTONOMY_DIR/PAUSED"
STATUS_FILE="$AUTONOMY_DIR/status.json"
TASK_FILE="$AUTONOMY_DIR/next-task.json"
WORKER_RESULT="${UBERBOND_WORKER_RESULT_PATH:-/var/lib/uberbond-worker/outbox/result.json}"
VERIFIED_FILE="$AUTONOMY_DIR/verified-change.json"
NODE_CONFIGURED="${UBERBOND_NODE_EXECUTABLE:-/usr/bin/node}"
NODE="$(realpath "$NODE_CONFIGURED" 2>/dev/null || true)"

mkdir -p "$AUTONOMY_DIR"
chmod 700 "$AUTONOMY_DIR" 2>/dev/null || true
[[ -d "$SOURCE_ROOT" && ! -L "$SOURCE_ROOT" ]] || { echo "REFUSED: real source directory required" >&2; exit 2; }
[[ -n "$NODE" && -x "$NODE" && ! -L "$NODE" ]] || { echo "REFUSED: trusted real Node executable required" >&2; exit 2; }
run_from_source(){ (cd "$SOURCE_ROOT" && "$@"); }
json_status(){ if [[ -f "$STATUS_FILE" && ! -L "$STATUS_FILE" ]]; then cat "$STATUS_FILE"; else printf '%s\n' '{"ok":true,"status":"NO_AUTONOMY_PULSE_RECORDED"}'; fi; }

wake(){
  run_from_source env \
    UBERBOND_CONTROL_DIR="$CONTROL_DIR" \
    UBERBOND_ISOLATED_WORKER_ENABLED="${UBERBOND_ISOLATED_WORKER_ENABLED:-false}" \
    UBERBOND_WORKER_INBOX_ROOT="${UBERBOND_WORKER_INBOX_ROOT:-/var/lib/uberbond-worker/inbox}" \
    UBERBOND_WORKER_TASK_PATH="${UBERBOND_WORKER_TASK_PATH:-/var/lib/uberbond-worker/inbox/task.json}" \
    "$NODE" scripts/sovereign-continuous-authoring-pulse.mjs
}

verify(){
  [[ -f "$TASK_FILE" && ! -L "$TASK_FILE" && -f "$WORKER_RESULT" && ! -L "$WORKER_RESULT" ]] || { echo "REFUSED: authoring task and isolated worker result required" >&2; exit 2; }
  run_from_source env \
    UBERBOND_CONTROL_DIR="$CONTROL_DIR" \
    UBERBOND_WORKER_OUTBOX_ROOT="${UBERBOND_WORKER_OUTBOX_ROOT:-/var/lib/uberbond-worker/outbox}" \
    UBERBOND_WORKER_RESULT_PATH="$WORKER_RESULT" \
    UBERBOND_REPOSITORY="${UBERBOND_REPOSITORY:-local/uberbond}" \
    "$NODE" scripts/sovereign-autonomy-verify.mjs
}

doctor(){
  run_from_source env \
    UBERBOND_CONTROL_DIR="$CONTROL_DIR" \
    UBERBOND_SOURCE_ROOT="$SOURCE_ROOT" \
    "$NODE" scripts/sovereign-bootstrap-doctor.mjs
}

pause(){ local tmp="${PAUSE_FILE}.tmp.$$"; printf 'paused_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$tmp"; chmod 600 "$tmp"; mv -f "$tmp" "$PAUSE_FILE"; printf '%s\n' 'FOUNDER_PAUSED'; }
resume(){ rm -f "$PAUSE_FILE"; printf '%s\n' 'FOUNDER_RESUMED'; wake; }
help(){ cat <<'EOF'
UberBond Sovereign Authoring Command Center

  uberbond-authorctl status   exact local autonomy receipt
  uberbond-authorctl wake     run one truth-first finite-or-Sandwich authoring pulse
  uberbond-authorctl pause    durably stop new authoring pulses
  uberbond-authorctl resume   remove pause and immediately wake
  uberbond-authorctl verify   independently verify isolated worker output
  uberbond-authorctl doctor   inspect sovereign self-completion activation truth
  uberbond-authorctl help     show this help

The model worker is a separate OS identity with read-only source and no access to
authoring receipts. Finite engineering retains priority; when exact-current finite
closure is proven, the same local pulse may emit one bounded Sandwich descendant-
genesis task. This control surface does not merge, sign, deploy, send, spend,
mutate DNS/credentials, contact customers, or grant business authority.
EOF
}
case "${1:-}" in
  status) json_status ;;
  wake) wake ;;
  pause) pause ;;
  resume) resume ;;
  verify) verify ;;
  doctor) doctor ;;
  help|--help|-h) help ;;
  *) help >&2; exit 2 ;;
esac