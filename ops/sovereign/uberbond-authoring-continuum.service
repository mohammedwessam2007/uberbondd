[Unit]
Description=UberBond sovereign resident authoring continuum
After=local-fs.target

[Service]
Type=simple
User=uberbond-author
Group=uberbond-autonomy
Environment=UBERBOND_AUTHOR_CONFIG=/etc/uberbond/authoring.env
Environment=UBERBOND_AUTHORING_INTERVAL_SEC=60
ExecStart=/opt/uberbond/control/uberbond-authoring-continuum
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/uberbond/source /var/lib/uberbond-control /var/lib/uberbond-worker/inbox /tmp
ReadOnlyPaths=/var/lib/uberbond-worker/outbox /etc/uberbond
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
UMask=0027
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
