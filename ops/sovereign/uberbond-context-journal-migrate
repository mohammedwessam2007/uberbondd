#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
CONFIG="${UBERBOND_AUTHOR_CONFIG:-/etc/uberbond/authoring.env}"
[[ -f "$CONFIG" && ! -L "$CONFIG" ]] || { echo "REFUSED: regular authoring config required" >&2; exit 2; }
# shellcheck disable=SC1090
source "$CONFIG"
SOURCE_ROOT="${UBERBOND_SOURCE_ROOT:?UBERBOND_SOURCE_ROOT required}"
CONTROL_DIR="${UBERBOND_CONTROL_DIR:-/var/lib/uberbond-control}"
AUTONOMY_DIR="$CONTROL_DIR/autonomy"
JOURNAL="${UBERBOND_CONTEXT_JOURNAL_PATH:-$CONTROL_DIR/context/events.jsonl}"
NODE_CONFIGURED="${UBERBOND_NODE_EXECUTABLE:-/usr/bin/node}"
NODE="$(realpath "$NODE_CONFIGURED" 2>/dev/null || true)"
[[ -d "$SOURCE_ROOT" && ! -L "$SOURCE_ROOT" ]] || { echo "REFUSED: real source root required" >&2; exit 2; }
[[ -n "$NODE" && -x "$NODE" && ! -L "$NODE" ]] || { echo "REFUSED: trusted Node required" >&2; exit 2; }
mkdir -p "$AUTONOMY_DIR"; chmod 700 "$AUTONOMY_DIR" 2>/dev/null || true
exec 9>"$AUTONOMY_DIR/authoring-pulse.lock"
flock -n 9 || { echo "REFUSED: authoring pulse active" >&2; exit 2; }
cd "$SOURCE_ROOT"
exec env UBERBOND_CONTROL_DIR="$CONTROL_DIR" UBERBOND_CONTEXT_JOURNAL_PATH="$JOURNAL" UBERBOND_CONTEXT_LAYERED_STORE_PATH="${UBERBOND_CONTEXT_LAYERED_STORE_PATH:-$CONTROL_DIR/context/journal-store}" "$NODE" scripts/sovereign-context-journal-migrate.mjs
