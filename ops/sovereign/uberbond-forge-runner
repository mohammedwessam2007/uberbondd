#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

CONFIG="${UBERBOND_FORGE_CONFIG:-/etc/uberbond-forge/forge.env}"
[[ -f "$CONFIG" && ! -L "$CONFIG" ]] || { echo '[uberbond-forge] REFUSED: regular forge config required' >&2; exit 2; }
# shellcheck disable=SC1090
set -a
source "$CONFIG"
set +a

[[ -n "${UBERBOND_FORGE_REPO:-}" ]] || { echo '[uberbond-forge] REFUSED: UBERBOND_FORGE_REPO required' >&2; exit 2; }
[[ -d "$UBERBOND_FORGE_REPO" && ! -L "$UBERBOND_FORGE_REPO" ]] || { echo '[uberbond-forge] REFUSED: dedicated forge repo missing' >&2; exit 2; }
[[ -n "${UBERBOND_RUNTIME_INBOX:-}" && -d "$UBERBOND_RUNTIME_INBOX" && ! -L "$UBERBOND_RUNTIME_INBOX" && -w "$UBERBOND_RUNTIME_INBOX" ]] || { echo '[uberbond-forge] REFUSED: writable runtime submission/receipt channel required' >&2; exit 2; }
[[ -n "${UBERBOND_RUNTIME_STATE_FILE:-}" && -f "$UBERBOND_RUNTIME_STATE_FILE" && ! -L "$UBERBOND_RUNTIME_STATE_FILE" ]] || { echo '[uberbond-forge] REFUSED: regular independent runtime-state evidence file required' >&2; exit 2; }
[[ ! -w "$UBERBOND_RUNTIME_STATE_FILE" ]] || { echo '[uberbond-forge] REFUSED: Forge must not be able to write runtime-state evidence' >&2; exit 2; }
command="${1:-cycle}"
case "$command" in
  doctor|cycle) ;;
  *) echo '[uberbond-forge] REFUSED: command must be doctor or cycle' >&2; exit 2 ;;
esac
cd "$UBERBOND_FORGE_REPO"
exec /usr/bin/node scripts/sovereign-autonomy-forge.mjs "$command"
