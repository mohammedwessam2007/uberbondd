[Unit]
Description=UberBond Sovereign Autonomy Forge bounded cycle
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=uberbond-forge
Group=uberbond-forge
Environment=UBERBOND_FORGE_CONFIG=/etc/uberbond-forge/forge.env
ExecStartPre=/opt/uberbond-forge/uberbond-forge-runner doctor
ExecStart=/opt/uberbond-forge/uberbond-forge-runner cycle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
TimeoutStartSec=45min
