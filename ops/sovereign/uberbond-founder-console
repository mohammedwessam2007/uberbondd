#!/usr/bin/env bash
set -Eeuo pipefail
[[ -r /etc/uberbond/authoring.env ]] || { echo 'authoring config unavailable' >&2; exit 2; }
# shellcheck disable=SC1091
source /etc/uberbond/authoring.env
[[ -r /etc/uberbond/founder-console.env ]] && source /etc/uberbond/founder-console.env
NODE="${UBERBOND_NODE_EXECUTABLE:-}"
[[ -n "$NODE" && -x "$NODE" && ! -L "$NODE" ]] || { echo 'real configured node executable required' >&2; exit 2; }
exec "$NODE" /opt/uberbond/source/scripts/sovereign-founder-console-server.mjs
