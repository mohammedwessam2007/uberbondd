#!/usr/bin/env bash
set -Eeuo pipefail
[[ -r /etc/uberbond/model.env ]] || { echo 'local model config unavailable' >&2; exit 2; }
set -a
# shellcheck disable=SC1091
source /etc/uberbond/model.env
set +a
NODE="$(realpath "${UBERBOND_NODE_EXECUTABLE:-/usr/bin/node}" 2>/dev/null || true)"
[[ -n "$NODE" && -x "$NODE" && ! -L "$NODE" ]] || { echo 'real configured node executable required' >&2; exit 2; }
exec "$NODE" /opt/uberbond/source/scripts/sovereign-local-model-proxy.mjs
