[Unit]
Description=UberBond read-only money capability world harvester
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=uberbond-author
Group=uberbond-autonomy
EnvironmentFile=/etc/uberbond/capability-genome.env
WorkingDirectory=/opt/uberbond/source
ExecStart=/usr/bin/node /opt/uberbond/source/scripts/capability-genome-money-world-pulse.mjs --execute-github --query-batch-size=10 --window-days=30 --max-provider-calls=80 --refresh-interval-sec=21600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/uberbond/source /etc/uberbond
ReadWritePaths=/var/lib/uberbond-capability-corpus
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
TimeoutStartSec=900
