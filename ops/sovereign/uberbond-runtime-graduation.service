[Unit]
Description=Observe UberBond sovereign runtime graduation evidence
After=local-fs.target docker.service uberbond-reconcile.service
Wants=uberbond-reconcile.timer

[Service]
Type=oneshot
ExecStart=/usr/bin/node /opt/uberbond/runtime-observer/ops/sovereign/observe-runtime-graduation.mjs
SuccessExitStatus=2
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadOnlyPaths=/opt/uberbond/runtime-observer -/mnt/uberbond-signer-outbox /var/lib/uberbond-control/inbox /etc/uberbond
ReadWritePaths=/var/lib/uberbond-control
