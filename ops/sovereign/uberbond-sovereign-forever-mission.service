[Unit]
Description=Renew UberBond sovereign founder mission lease
After=local-fs.target uberbond-founder-console.service

[Service]
Type=oneshot
User=uberbond-author
Group=uberbond-author
Environment=UBERBOND_CONTROL_DIR=/var/lib/uberbond-control
WorkingDirectory=/opt/uberbond/source
ExecStart=/usr/bin/node /opt/uberbond/source/scripts/sovereign-forever-mission-renewer.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/opt/uberbond/source
ReadWritePaths=/var/lib/uberbond-control
ProtectHome=true

[Install]
WantedBy=multi-user.target
