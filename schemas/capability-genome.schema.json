{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uberbond.local/schemas/capability-genome.schema.json",
  "title": "UberBond Capability Genome Capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "canonicalIdentity", "aliases", "source", "sourceType",
    "sourceRevision", "sourceHash", "maintainer", "license", "licenseConfidence",
    "capabilityAtoms", "taskClasses", "inputs", "outputs", "sideEffects", "dataClasses",
    "permissions", "credentialRequirements", "networkRequirements", "dependencies",
    "executionEnvironment", "supportedAgents", "supportedModels", "supportedProviders",
    "contextCost", "tokenCost", "monetaryCost", "latency", "reliability",
    "maintainerHealth", "securityEvidence", "knownVulnerabilities", "knownConflicts",
    "compatibilityEdges", "substitutes", "benchmarks", "realUsageEvidence",
    "economicPrior", "founderMinutesSaved", "observedOutcomes", "versionHistory",
    "promotionState", "revocationState", "lastEvaluatedAt", "evidencePointers"
  ],
  "properties": {
    "schemaVersion": { "const": "uberbond.capability-genome.capability.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{1,199}$" },
    "canonicalIdentity": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{1,239}$" },
    "aliases": { "$ref": "#/$defs/stringArray" },
    "source": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string", "format": "uri" }, "packageIdentity": { "type": ["string", "null"] }, "lineageRoot": { "type": ["string", "null"] } }, "additionalProperties": true },
    "sourceType": { "enum": ["SKILL", "MCP_SERVER", "CLI", "LIBRARY", "SDK", "API", "PLUGIN", "AGENT", "FRAMEWORK_PRIMITIVE", "DOCKER_SERVICE", "BROWSER_TOOL", "WORKFLOW", "GITHUB_ACTION", "RUNTIME", "HOSTED_SERVICE", "NATIVE"] },
    "sourceRevision": { "type": "string", "minLength": 1, "maxLength": 240 },
    "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "maintainer": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } }, "additionalProperties": true },
    "license": { "type": "string" },
    "licenseConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "capabilityAtoms": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/atom" } },
    "taskClasses": { "$ref": "#/$defs/stringArray" },
    "inputs": { "$ref": "#/$defs/stringArray" },
    "outputs": { "$ref": "#/$defs/stringArray" },
    "sideEffects": { "type": "array", "items": { "enum": ["NONE", "READ_ONLY_NETWORK", "LOCAL_WRITE", "EXTERNAL_WRITE", "MESSAGE", "DEPLOYMENT", "PRODUCTION_MUTATION", "MONEY_MOVEMENT", "SECURITY_TEST"] } },
    "dataClasses": { "type": "array", "items": { "enum": ["PUBLIC", "INTERNAL_NON_SECRET", "SOURCE_CODE", "PRIVATE_CUSTOMER", "CREDENTIAL", "PAYMENT_RAW"] } },
    "permissions": { "$ref": "#/$defs/stringArray" },
    "credentialRequirements": { "$ref": "#/$defs/stringArray" },
    "networkRequirements": { "$ref": "#/$defs/stringArray" },
    "dependencies": { "$ref": "#/$defs/stringArray" },
    "executionEnvironment": { "type": "object" },
    "supportedAgents": { "$ref": "#/$defs/stringArray" },
    "supportedModels": { "$ref": "#/$defs/stringArray" },
    "supportedProviders": { "$ref": "#/$defs/stringArray" },
    "contextCost": { "type": "object" }, "tokenCost": { "type": "object" }, "monetaryCost": { "type": "object" },
    "latency": { "type": "object" }, "reliability": { "type": "object" }, "maintainerHealth": { "type": "object" },
    "securityEvidence": { "type": "array" }, "knownVulnerabilities": { "$ref": "#/$defs/stringArray" },
    "knownConflicts": { "$ref": "#/$defs/stringArray" }, "compatibilityEdges": { "type": "array" },
    "substitutes": { "$ref": "#/$defs/stringArray" }, "benchmarks": { "type": "array" },
    "realUsageEvidence": { "type": "array" }, "economicPrior": { "type": "object" },
    "founderMinutesSaved": { "type": "object" }, "observedOutcomes": { "type": "array" },
    "versionHistory": { "type": "array" },
    "promotionState": { "enum": ["DISCOVERED", "NORMALIZED", "DEDUPED", "SECURITY_REVIEWED", "ELIGIBLE", "SANDBOXED", "BENCHMARKED", "APPROVED", "ACTIVE", "DEGRADED", "REPLACED", "REVOKED", "ARCHIVED"] },
    "revocationState": { "type": "object", "required": ["revoked"] },
    "lastEvaluatedAt": { "type": "string", "format": "date-time" },
    "evidencePointers": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
  },
  "$defs": {
    "stringArray": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 1000 }, "uniqueItems": true },
    "atom": { "type": "object", "additionalProperties": false, "required": ["id", "verb", "noun", "description", "inputs", "outputs", "sideEffectClass"], "properties": { "id": { "type": "string" }, "verb": { "type": "string" }, "noun": { "type": "string" }, "description": { "type": "string" }, "inputs": { "$ref": "#/$defs/stringArray" }, "outputs": { "$ref": "#/$defs/stringArray" }, "sideEffectClass": { "type": "string" } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["type", "ref", "observedAt"], "properties": { "type": { "type": "string" }, "ref": { "type": "string" }, "observedAt": { "type": "string", "format": "date-time" }, "digest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "claimClass": { "type": "string" } } }
  }
}
