{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uberbond.local/schemas/uberos-machine-manifest.schema.json",
  "title": "UBER/OS machine manifest",
  "type": "object",
  "required": ["schemaVersion", "identity", "authorityRoot", "packages", "kernelAdapters", "requiredKernelCapabilities"],
  "properties": {
    "schemaVersion": { "const": "uberos.machine-manifest.v1" },
    "identity": {
      "type": "object",
      "required": ["name", "generation"],
      "properties": {
        "name": { "const": "UBER/OS" },
        "generation": { "type": "string" }
      },
      "additionalProperties": true
    },
    "authorityRoot": { "type": "object" },
    "packages": { "type": "array", "minItems": 1 },
    "kernelAdapters": { "type": "array", "minItems": 1 },
    "requiredKernelCapabilities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "preferredKernelClass": { "type": "string" },
    "updatePolicy": { "type": "object" },
    "aiPolicy": { "type": "object" }
  },
  "additionalProperties": true
}
