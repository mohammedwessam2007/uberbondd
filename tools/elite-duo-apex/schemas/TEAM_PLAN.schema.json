{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TEAM_PLAN",
  "type": "object",
  "required": [
    "team_name",
    "lead",
    "members",
    "tasks",
    "file_ownership",
    "dependencies",
    "stop_rules"
  ],
  "properties": {
    "team_name": {
      "type": "string"
    },
    "lead": {
      "type": "string"
    },
    "members": {
      "type": "array"
    },
    "tasks": {
      "type": "array"
    },
    "file_ownership": {
      "type": "array"
    },
    "dependencies": {
      "type": "array"
    },
    "stop_rules": {
      "type": "array"
    }
  }
}
