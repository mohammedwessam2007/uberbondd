{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node -e \"console.log('UBERCEL_TERMINAL_CELL_READY')\"",
  "functions": {
    "api/founder-center.mjs": {
      "maxDuration": 60,
      "includeFiles": "{NORTH_STAR.md,docs/CURRENT_HANDOFF.json,UBERBOND_BOOTSTRAP.json}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
