{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run check:syntax && npm run test:deterministic && node scripts/uberbond-feature-genome.mjs && node scripts/uberbond-feature-atom-atlas.mjs && node scripts/uberbond-synaptic-map.mjs",
  "functions": {
    "api/agent-relay.mjs": { "maxDuration": 60 },
    "api/agent-mesh-cron.mjs": { "maxDuration": 60 },
    "api/database-maintenance.mjs": { "maxDuration": 60 },
    "api/webhooks/billing.mjs": { "maxDuration": 30 },
    "api/admin/health-check.mjs": { "maxDuration": 30 },
    "api/command-center.mjs": {
      "maxDuration": 30,
      "includeFiles": "{config/frontier-model-candidates.json,artifacts/perpetual-frontier-implementation-ledger.json,artifacts/uberbond-*-latest.json,artifacts/cognitive/*-latest.json}"
    }
  },
  "rewrites": [
    { "source": "/uberbond", "destination": "/uberbond.html" }
  ],
  "crons": [
    {
      "path": "/api/agent-mesh-cron",
      "schedule": "17 12 * * *"
    },
    {
      "path": "/api/database-maintenance",
      "schedule": "37 2 * * 0"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
